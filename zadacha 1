#include <stdio.h>
#include <ctype.h> // для tolower()
int main() {
    char letter = 'L'; // Теперь работает и с заглавными буквами
    int position;
    if (isalpha(letter)) {
        position = tolower(letter) - 'a' + 1;
        printf("Буква '%c' находится на позиции %d\n", letter, position);
    } else {
        printf("'%c' не является буквой английского алфавита\n", letter);
    }
    return 0;
}
